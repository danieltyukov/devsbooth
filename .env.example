# Copy to .env and adjust. Every variable is optional unless marked required.

# The address people open in their browser. Required for anything other than localhost.
# Use https in production: browsers only allow microphone access on https (and localhost).
APP_URL=http://localhost:3000

# Port inside the container or for `npm start`. compose.yaml publishes it on the host.
# PORT=3000

# Required outside docker compose and `npm run dev`.
# MONGODB_URI=mongodb://localhost:27017/devsbooth

# Sign-in emails. Without SMTP_URL the code is printed to the server log, which is
# fine for trying DevsBooth out but not for real users.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=DevsBooth <no-reply@example.com>

# STUN and TURN servers as JSON. The default is Google's public STUN server.
# Add a TURN server if people behind strict NATs cannot hear each other.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# "relay" sends all audio through your TURN server, so people in a room do not see each
# other's IP addresses. Needs a TURN server in ICE_SERVERS.
# ICE_TRANSPORT_POLICY=all

# Set when running behind a reverse proxy, so client IPs and https are detected.
# TRUST_PROXY=1

# Rooms
# ROOM_MAX_PARTICIPANTS=25
# ROOM_EMPTY_TTL=300

# Sign-in requests per IP per 15 minutes. 0 disables the limit.
# AUTH_RATE_LIMIT=30

# debug, info, warn, error or silent
# LOG_LEVEL=info
